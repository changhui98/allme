# 프론트 환경변수 템플릿 (커밋되는 유일한 env 파일)
# 복사해서 사용: cp front/.env.example front/.env.local

# 포트원 V2 본인인증 (콘솔 https://admin.portone.io > 연동 정보)
# - Store ID: 연동 정보 우측 상단
# - Channel Key: 채널 관리 > 본인인증 채널(KG이니시스 통합인증, 테스트 모드) 생성 후 확인
# 미설정 시 회원가입 본인인증 스텝에 준비 중 안내가 표시된다
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# 백엔드 API 베이스 URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 사이트 베이스 URL (metadataBase — OG 이미지 등 절대 URL 기준. 배포 시 실제 도메인으로 교체)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
