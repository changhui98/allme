# ──────────────────────────────────────────────
# 두레(Dure) — 루트 통합 .gitignore
# git/.gitignore는 이 루트 한 곳에서만 관리한다(하위 폴더에 별도 .gitignore 두지 않음).
# 패턴은 unanchored로 작성해 front/ 등 모든 하위 폴더에 적용되게 한다.
# ──────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output (Next.js / NestJS 등)
.next/
out/
build/
dist/

# Testing / coverage
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables (.env.example만 커밋)
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Caches
.cache/
.turbo/
.eslintcache

# Vercel
.vercel

# Editors / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# OS files
.DS_Store
._*
Thumbs.db