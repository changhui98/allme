# ──────────────────────────────────────────────
# 올미(allme) — 루트 통합 .gitignore
# git/.gitignore는 이 루트 한 곳에서만 관리한다(하위 폴더에 별도 .gitignore 두지 않음).
# 패턴은 unanchored로 작성해 front/ 등 모든 하위 폴더에 적용되게 한다.
# ──────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output (Next.js / NestJS 등)
.next/
out/
build/
dist/

# Testing / coverage
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Markdown 문서 (혼자 개발 — CLAUDE.md 등 로컬 문서는 추적 제외)
*.md

# Environment variables (.env.example만 커밋)
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Caches
.cache/
.turbo/
.eslintcache

# Vercel
.vercel

# Java / Gradle (back)
.gradle/
bin/
.classpath
.project
.settings/
.factorypath
.apt_generated/
.springBeans
.sts4-cache

# Editors / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.iws
*.ipr
*.swp

# OS files
.DS_Store
._*
Thumbs.db
# 내부 기획 문서 (저장소에 올리지 않음)
올미_서비스_기획안.md

# 업로드 이미지 (로컬 파일 저장소 — 코드가 디렉터리를 자동 생성한다)
/images/
