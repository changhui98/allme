# 백엔드 환경변수 템플릿 (커밋되는 유일한 env 파일)
# 복사해서 사용: cp back/.env.example back/.env.dev  (또는 .env.prod)
# - .env.dev  → docker-compose.yml (개발)
# - .env.prod → docker-compose.prod.yml (배포, 비밀번호 필수 교체)

# db 컨테이너 초기화용 (postgres 이미지)
POSTGRES_DB=allme
POSTGRES_USER=allme
POSTGRES_PASSWORD=allme

# back 컨테이너용 — 컴포즈 네트워크 내부 주소 (호스트에서 접속할 땐 localhost:5433)
DB_HOST=db
DB_PORT=5432
DB_NAME=allme
DB_USERNAME=allme
DB_PASSWORD=allme

# 탈퇴 회원 보관 전용 DB (db-archive 컨테이너, 호스트에서는 localhost:5434)
# 컨테이너 초기화 계정(ARCHIVE_POSTGRES_*)은 컴포즈 변수 보간용이라 저장소 루트 .env에서
# 오버라이드한다(미설정 시 allme_archive/allme/allme). 백엔드 접속은 아래 키를 사용.
ARCHIVE_DB_NAME=allme_archive
ARCHIVE_DB_USERNAME=allme
ARCHIVE_DB_PASSWORD=allme

# 포트원 V2 본인인증 (콘솔 https://admin.portone.io > 개발자센터 > V2 API Secret)
# 미설정 시 검증 API가 503(U004)을 반환하고 나머지 기능은 정상 동작
PORTONE_API_SECRET=

# 개인정보 필드 암호화 키 — AES-256-GCM(이름·CI·DI·휴대폰)·HMAC-SHA256(CI 중복체크 해시)
# 각각 base64 32바이트: openssl rand -base64 32
# 개발은 미설정 시 application.yaml의 dev 기본 키 사용, 운영은 반드시 별도 키 주입.
# 주의: 키를 바꾸면 기존에 암호화 저장된 데이터를 복호화할 수 없다.
CRYPTO_ENC_KEY=
CRYPTO_HMAC_KEY=

# 업로드 이미지 루트 (미설정 시 back/ 기준 ../images = 저장소 루트 images/)
# 도커 컴포즈는 ./images:/images 볼륨과 함께 IMAGES_ROOT=/images를 주입한다
# IMAGES_ROOT=/images

# CORS 허용 오리진 (쉼표 구분, 기본값: http://localhost:3001)
# CORS_ALLOWED_ORIGINS=http://localhost:3001

# 세션 타임아웃 (기본 30m). 개발 시 만료 UX 테스트용으로 1m 등으로 단축 가능(톰캣 최소 1분)
# SESSION_TIMEOUT=30m

# true면 기동 시 역할별 테스트 계정 4종 시드(testuser·testprovider·testmanager·testadmin, 비밀번호 Test1234!)
# 개발 전용 — 운영(.env.prod)에서는 절대 켜지 말 것
# SEED_TEST_ACCOUNTS=true

# 배포 전용 (운영에서 스키마 자동 변경 금지)
# SPRING_JPA_HIBERNATE_DDL_AUTO=validate
